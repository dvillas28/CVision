NODE_ENV=development
PORT=4000
API_PREFIX=/api
DATABASE_URL=postgresql://cvision:cvision@localhost:5433/cvision?schema=public
# Conexion directa (sin pooler) usada por Prisma Migrate. En local es igual a DATABASE_URL.
DIRECT_URL=postgresql://cvision:cvision@localhost:5433/cvision?schema=public
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
AI_IMPROVE_FIELD_MAX_OUTPUT_TOKENS=2048
# Respaldo opcional: si Gemini responde 429 o 5xx se reintenta con Groq
GROQ_API_KEY=
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MAX_OUTPUT_TOKENS=4096
# Limites de uso de IA por usuario autenticado
AI_RATE_LIMIT_PER_MINUTE=5
AI_DAILY_LIMIT_PER_USER=30
